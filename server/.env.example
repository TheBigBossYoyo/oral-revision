# ============================================================
# Configuration du backend Gemini (NE PAS committer le vrai .env)
# Copiez ce fichier en "server/.env" puis renseignez votre cle.
# ============================================================

# Votre cle API Google Gemini (obtenue sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=ma_cle_api

# Modele Gemini utilise (flash = rapide et peu couteux).
# Vous pouvez le changer sans toucher au code : ex. gemini-2.0-flash, gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# Port du backend local
PORT=8787
